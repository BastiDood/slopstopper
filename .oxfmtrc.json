{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"arrowParens": "avoid",
	"printWidth": 100,
	"singleQuote": true,
	"trailingComma": "all",
	"useTabs": true,
	"sortImports": true,
	"sortPackageJson": false,
	"ignorePatterns": ["node_modules", "dist", "pnpm-lock.yaml"],
	"overrides": [
		{
			"files": ["**/*.yaml"],
			"options": { "useTabs": false, "tabWidth": 2 }
		}
	]
}
