{
	"name": "@bastidood/eslint-config-svelte",
	"version": "0.1.0",
	"description": "Svelte rules and type-aware parsing for ESLint, composed with @bastidood/eslint-config.",
	"license": "MIT",
	"homepage": "https://github.com/BastiDood/slopstopper",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BastiDood/slopstopper.git",
		"directory": "configs/eslint-svelte"
	},
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"exports": {
		"./svelte": "./src/svelte.ts",
		"./tanstack-svelte-query": "./src/tanstack-svelte-query.ts"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			"./svelte": "./dist/svelte.mjs",
			"./tanstack-svelte-query": "./dist/tanstack-svelte-query.mjs"
		}
	},
	"scripts": {
		"prepack": "tsdown",
		"check": "tsc"
	},
	"dependencies": {
		"eslint-plugin-svelte": "^3.23.1",
		"typescript-eslint": "catalog:"
	},
	"devDependencies": {
		"@bastidood/tsconfig": "workspace:*",
		"@typescript/native": "catalog:",
		"eslint": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@bastidood/eslint-config": "workspace:^",
		"eslint": "^10.0.0",
		"svelte": "^5.0.0",
		"typescript": ">=4.8.4 <6.1.0"
	}
}
