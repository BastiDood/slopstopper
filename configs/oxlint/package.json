{
	"name": "@bastidood/oxlint-config",
	"version": "0.1.0",
	"description": "Strict baseline Oxlint configuration for type-aware TypeScript projects.",
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"exports": {
		".": "./src/compose/index.ts",
		"./restrictions": "./src/restrictions/index.ts",
		"./core": "./src/core.ts",
		"./unicorn": "./src/unicorn.ts",
		"./promise": "./src/promise.ts",
		"./react": "./src/react.ts",
		"./jsx-a11y": "./src/jsx-a11y.ts",
		"./tanstack-react-query": "./src/tanstack-react-query.ts"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/compose/index.mjs",
			"./restrictions": "./dist/restrictions/index.mjs",
			"./core": "./dist/core.mjs",
			"./unicorn": "./dist/unicorn.mjs",
			"./promise": "./dist/promise.mjs",
			"./react": "./dist/react.mjs",
			"./jsx-a11y": "./dist/jsx-a11y.mjs",
			"./tanstack-react-query": "./dist/tanstack-react-query.mjs"
		}
	},
	"scripts": {
		"prepack": "tsdown",
		"check": "tsc"
	},
	"devDependencies": {
		"@bastidood/tsconfig": "workspace:*",
		"@typescript/native": "catalog:",
		"oxlint": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"oxlint": "^1.89.0",
		"oxlint-plugin-eslint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005"
	}
}
