{
	"name": "@bastidood/oxlint-config",
	"version": "0.0.0",
	"description": "Strict baseline Oxlint configuration for type-aware TypeScript projects.",
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc"
	},
	"dependencies": {
		"oxlint-plugin-eslint": "^1.89.0"
	},
	"devDependencies": {
		"@bastidood/tsconfig": "workspace:*",
		"@typescript/native": "catalog:",
		"oxlint": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"oxlint": "^1.89.0"
	}
}
