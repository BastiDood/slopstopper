{
	"name": "@bastidood/oxlint-config",
	"version": "0.5.0",
	"description": "Strict baseline Oxlint configuration for type-aware TypeScript projects.",
	"license": "MIT",
	"homepage": "https://github.com/BastiDood/slopstopper",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BastiDood/slopstopper.git",
		"directory": "configs/oxlint"
	},
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"exports": {
		".": "./src/compose/index.ts",
		"./restrictions": "./src/restrictions/index.ts",
		"./core": "./src/core.ts",
		"./react": "./src/react/index.ts",
		"./react/compiler": "./src/react/compiler.ts",
		"./react/tanstack/table": "./src/react/tanstack/table.ts",
		"./jsx-a11y": "./src/jsx-a11y.ts",
		"./tanstack/query": "./src/tanstack/query.ts",
		"./tanstack/table": "./src/tanstack/table.ts",
		"./next": "./src/next.ts",
		"./vitest": "./src/vitest.ts",
		"./node": "./src/node.ts"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/compose/index.mjs",
			"./restrictions": "./dist/restrictions/index.mjs",
			"./core": "./dist/core.mjs",
			"./react": "./dist/react/index.mjs",
			"./react/compiler": "./dist/react/compiler.mjs",
			"./react/tanstack/table": "./dist/react/tanstack/table.mjs",
			"./jsx-a11y": "./dist/jsx-a11y.mjs",
			"./tanstack/query": "./dist/tanstack/query.mjs",
			"./tanstack/table": "./dist/tanstack/table.mjs",
			"./next": "./dist/next.mjs",
			"./vitest": "./dist/vitest.mjs",
			"./node": "./dist/node.mjs"
		}
	},
	"scripts": {
		"prepack": "tsdown",
		"check": "tsc"
	},
	"devDependencies": {
		"@bastidood/eslint-plugin-slopstopper": "workspace:*",
		"@bastidood/tsconfig": "workspace:*",
		"@typescript/native": "catalog:",
		"oxlint": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@bastidood/eslint-plugin-slopstopper": "workspace:^",
		"oxlint": "catalog:",
		"oxlint-plugin-eslint": "catalog:",
		"oxlint-tsgolint": "catalog:"
	}
}
