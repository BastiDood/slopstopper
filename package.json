{
	"type": "module",
	"private": true,
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.16.1",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "^26.13.0",
			"onFail": "download"
		}
	},
	"scripts": {
		"fmt": "oxfmt --check .",
		"fmt:fix": "oxfmt .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"check": "tsc --build",
		"test": "vitest run"
	},
	"devDependencies": {
		"@bastidood/oxfmt-config": "workspace:*",
		"@bastidood/oxlint-config": "workspace:*",
		"@bastidood/tsconfig": "workspace:*",
		"@typescript/native": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-plugin-eslint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
