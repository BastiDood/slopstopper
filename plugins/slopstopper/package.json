{
	"name": "@bastidood/eslint-plugin-slopstopper",
	"version": "0.5.1",
	"description": "Custom lint rules against sloppy code, for both Oxlint and ESLint.",
	"license": "MIT",
	"type": "module",
	"homepage": "https://github.com/BastiDood/slopstopper",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BastiDood/slopstopper.git",
		"directory": "plugins/slopstopper"
	},
	"imports": {
		"#*": "./src/*"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"THIRD-PARTY-NOTICES.md"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.mjs"
		}
	},
	"scripts": {
		"prepack": "tsdown",
		"check": "tsc"
	},
	"dependencies": {
		"@oxlint/plugins": "catalog:"
	},
	"devDependencies": {
		"@bastidood/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"eslint": "catalog:",
		"oxlint": "catalog:",
		"svelte": "^5.57.3",
		"svelte-eslint-parser": "^1.10.1",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vitest": "catalog:"
	}
}
